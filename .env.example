# Copy to .env.local for local work; in production set these in the Vercel project settings.
# All three are baked in at build time and the build fails without them.

# Where this landing is published (hreflang, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=
# The web app (Log in, privacy, terms)
NEXT_PUBLIC_APP_URL=
# Backend the trial / demo forms post to
NEXT_PUBLIC_API_URL=
